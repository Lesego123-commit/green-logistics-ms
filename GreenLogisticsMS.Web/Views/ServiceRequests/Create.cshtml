@model ServiceRequestModel
@{
    ViewData["Title"] = "New Service Request";
    var contracts = ViewBag.Contracts as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}
<h2>New Service Request</h2>
<p class="text-muted">The API converts the USD cost to ZAR using a live exchange rate, and blocks requests on expired / on-hold contracts.</p>
<div class="row"><div class="col-md-6">
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="ContractId" class="form-label"></label>
        <select asp-for="ContractId" asp-items="contracts" class="form-select"><option value="">-- select contract --</option></select>
        <span asp-validation-for="ContractId" class="text-danger"></span>
    </div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="RequestType" class="form-label"></label><select asp-for="RequestType" asp-items="Html.GetEnumSelectList<RequestType>()" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="CostUSD" class="form-label"></label><input asp-for="CostUSD" class="form-control" type="number" step="0.01" /><span asp-validation-for="CostUSD" class="text-danger"></span></div>
    <button type="submit" class="btn btn-success">Create</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
