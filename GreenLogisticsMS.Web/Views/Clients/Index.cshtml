@model List<ClientModel>
@{
    ViewData["Title"] = "Clients";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clients</h2>
    <a class="btn btn-success" asp-action="Create">+ New Client</a>
</div>
<table class="table table-striped table-hover">
    <thead><tr><th>Name</th><th>Contact</th><th>Region</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.ContactDetails</td>
            <td>@c.Region</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@c.Id">Details</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">No clients yet. The API returned an empty list (or your session expired).</p>
}
