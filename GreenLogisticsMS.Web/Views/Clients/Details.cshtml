@model ClientModel
@{
    ViewData["Title"] = "Client Details";
}
<h2>@Model.Name</h2>
<dl class="row">
    <dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.ContactDetails</dd>
    <dt class="col-sm-3">Region</dt><dd class="col-sm-9">@Model.Region</dd>
</dl>
<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-link" asp-action="Index">Back to list</a>
