@model ContractFilterModel
@{
    ViewData["Title"] = "Search Contracts";
}
<h2>Search / Filter Contracts</h2>
<form asp-action="Search" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()" class="form-select"><option value="">Any</option></select>
    </div>
    <div class="col-auto"><label asp-for="StartFrom" class="form-label"></label><input asp-for="StartFrom" type="date" class="form-control" /></div>
    <div class="col-auto"><label asp-for="StartTo" class="form-label"></label><input asp-for="StartTo" type="date" class="form-control" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-success">Search</button></div>
</form>
<table class="table table-striped">
    <thead><tr><th>#</th><th>Client</th><th>Start</th><th>End</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var c in Model.Results)
    {
        <tr>
            <td>@c.Id</td><td>@c.ClientName</td>
            <td>@c.StartDate.ToString("yyyy-MM-dd")</td>
            <td>@c.EndDate.ToString("yyyy-MM-dd")</td>
            <td><span class="badge bg-secondary">@c.Status</span></td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Results.Any()) { <p class="text-muted">No matching contracts.</p> }
